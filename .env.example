# Copiar a .env (local) y cargar en Vercel (Settings → Environment Variables). Nunca subir valores al repo.

# Claude (escribe el texto de la lectura)
ANTHROPIC_API_KEY=
# Opcional: modelo (por defecto claude-opus-5-5)
CLAUDE_MODELO=
# Opcional: esfuerzo de razonamiento: low | medium | high | xhigh | max (por defecto medium)
CLAUDE_ESFUERZO=

# OpenAI (ilustraciones)
OPENAI_API_KEY=
# Opcionales: modelo (gpt-image-2), calidad (low|medium|high) y precio por imagen en USD para calcular el costo
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
OPENAI_COSTO_IMAGEN_USD=

# Clave que se escribe en la página para poder generar lecturas
CLAVE_ACCESO=
